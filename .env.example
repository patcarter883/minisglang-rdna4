# Local overrides for docker-compose.yml. Copy to `.env` and edit — docker compose loads it
# automatically from the project directory, and `.env` is gitignored.
#
# Every value below already has a portable default in docker-compose.yml, so a fresh clone runs
# with no .env at all. You only need this file to point the stack at storage you already have.

# Hugging Face cache. Default: ${HOME}/.cache/huggingface
# Set this if your weights live elsewhere — otherwise a first run re-downloads them.
#HF_HOME=/path/to/your/hf-cache

# Checkpoint directories. Defaults are ./models, ./models/drafts, ./models/q4e, ./models/q4e-ple.
# Docker CREATES these empty on `up`, so a serve pointed at a missing model fails preflight
# rather than silently doing nothing.
#MODELS_DIR=/path/to/models
#DRAFT_DIR=/path/to/draft-checkpoints
#BIG_MODELS_DIR=/path/to/large-checkpoints
#Q4E_MODEL_DIR=/path/to/qwen4exp
#Q4E_PLE_DIR=/path/to/qwen4exp-ple

# Canonical HIP kernels. Default: ../rdna4-hip-kernels (a sibling checkout).
#RDNA4_HIP_KERNELS=/path/to/rdna4-hip-kernels

# AMD uProf .deb directory for the CPU-profiling build stage. Default: ./docker/uprof, a
# placeholder that makes the stage skip cleanly. AMD gates the .deb behind a EULA click-through,
# so it cannot be fetched at build time — drop it here to get uProf in the image.
#UPROF_PKG_DIR=/path/to/uprof-deb-dir

# Ghost-oracle state. Default: the named volume `minisgl-ghost-oracle`.
# This accumulates over days and is used to score prefix reuse, so point it at a durable host
# path if you want it to survive `docker compose down -v`.
#GHOST_ORACLE_DIR=/path/to/ghost-oracle

# rocprofv3 mutex directory, shared by profiling containers to serialise counter collection.
# Default: /tmp/minisgl-profile-locks. Must be the SAME path inside and outside the container.
#PROFILE_LOCK_DIR=/tmp/minisgl-profile-locks
