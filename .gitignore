build/
dist/
*.tar.gz
*.so

# ephemeral run/bench logs (test output, not source)
*.out
tools/*.server.log
tools/*.oldmoe1.log

# virtual environment
.venv/
venv/
env/

# clangd config
.clangd

# .vscode
