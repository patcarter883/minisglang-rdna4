# pycache
__pycache__/
*.py[cod]
*$py.class

# installed packages
*.dist-info/
*.egg-info/

# json files
*.json
*.jsonl
# ...but keep version-controlled monitoring dashboards
!monitoring/grafana/*.json
# ...and the control panel's tracked config template (the real config.json stays local)
!control-panel/config.example.json

# profiling data
*.nsys-rep
*.ncu-rep

# binaries
build/
dist/
*.tar.gz
*.so

# ephemeral run/bench logs (test output, not source)
*.out
tools/*.server.log
tools/*.oldmoe1.log

# virtual environment
.venv/
venv/
env/

# clangd config
.clangd

# .vscode
.vscode/
.coverage

# torch artifacts
*.pt
.triton-cache-3c/
tools/tp2_results/
tools/glm_smoke.server.log
tools/seed_*.log
tools/spec_sweep.*.log
tools/qwen35b_smoke.*.log
tools/sweep_*.window.log
tools/mla_spec_graph.*.log
tools/*.log
tools/*.out

# Compiled HIP kernel extensions — built per checkout, never committed
*.so

# ddtree validation run artifacts
tools/_ddtree_run/
tools/.triton-ddtree-cap/
tools/ddtree_cap.*.log

# ddtree validation run artifacts (worktree-root triton copy + logs)
.triton-ddtree-cap/
tools/_ddtree_run/
tools/ddtree_cap.*.log
tools/ll.*.json
tools/kperf_results/
tools/tp2_results/
.cam_gte/
.cam_gte/
.cam_gte/
.cam_gte/
.cam_gte/
.cam_gte/
.cam_gte/
.cam_store/
.cam_gte/
.cam_store/
.cam_gte/
.cam_store/
.cam_gte/
.cam_store/
.cam_gte/
.cam_store/
.cam_gte/
.cam_store/
**.log

# propose-capture A/B raw per-step draft-chain dumps (regenerable by tools/propose_capture_ab.sh;
# the verdicts they support are in the committed tools/propose_capture_ab_*.txt summaries)
tools/_pcab_*.txt
rpv3out-*/
docker-compose.rocprof-*.yml
_tp_overlap_ab/

# Kernel packages staged into the mount by an A/B harness (built .so, root-owned pycache).
/_kern/

# Profiling scratch. These were COMMITTED once and cost ~4.9 GB across 7 blobs, every one of them
# over GitHub's hard 100 MiB per-file limit, which made the repo unpushable until the history was
# purged. rocprofv3 writes kernel traces that run to >1 GB for a single profiled serve.
.rocprofv3/
_rocprof_*/
**/_rocprof_*/
*kernel_trace.csv
*kernel_trace.dat

# Repo-relative default for the compose /models, /drafts and qwen4_exp mounts (docker creates it
# on `up` when MODELS_DIR/DRAFT_DIR are not pointed at a real checkpoint dir). Checkpoints are
# hundreds of GB — never committed.
/models/

# Local environment overrides. docker compose auto-loads .env from the project directory, which is
# how this box keeps its own absolute paths (HF cache, model dirs, the ghost-oracle bind) while the
# compose defaults stay portable for anyone who clones the repo. See .env.example.
.env
.env.*
!.env.example
